# Backend environment (Render / local)
# Comma-separated list of allowed frontend origins for CORS:
# - local Vite dev server
# - your Vercel production domain
ALLOWED_ORIGINS=http://localhost:5173,https://stacklens-purple.vercel.app

# Optional: increases GitHub API rate limits (keep secret, never expose to frontend)
# GITHUB_TOKEN=ghp_...

# Optional: server port (Render sets PORT automatically)
# PORT=4000

# Optional: rate limiting (requests per minute per client)
# RATE_LIMIT_ANON=10
# RATE_LIMIT_AUTH=100
# Stricter limit for auth endpoints (per IP per minute)
# RATE_LIMIT_AUTH_ROUTES=5

# Optional: distributed rate limiting (Vercel) via Upstash Redis
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: override GitHub API base (used by local mock-server tests)
# GITHUB_API_BASE=http://localhost:4999

# ---------------------------------------------------------------------------
# Accounts (Phase 2) — all optional; the app boots and serves /api/analyze
# without any of these. Auth endpoints return 503 CONFIG_MISSING until set.
# ---------------------------------------------------------------------------

# Postgres connection string (Neon free tier works; use the POOLED string).
# Required for auth and saved reports. Run `npm run migrate` after setting it.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign auth sessions/tokens. Generate with: openssl rand -base64 32
# Required together with DATABASE_URL to enable auth.
# BETTER_AUTH_SECRET=

# Public base URL of the auth (backend) server.
# BETTER_AUTH_URL=http://localhost:4000

# Extra origins allowed to call the auth API (comma-separated), e.g. your
# Vercel domain. http://localhost:5173 is always trusted.
# TRUSTED_ORIGINS=https://stacklens-purple.vercel.app

# GitHub OAuth app — https://github.com/settings/developers (New OAuth App)
# Callback URL (dev):  http://localhost:4000/api/auth/callback/github
# Callback URL (prod): https://<your-domain>/api/auth/callback/github
# Both set = "Sign in with GitHub" enabled.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Magic-link emails via Resend — https://resend.com (verify your domain, or use
# onboarding@resend.dev for tests). Both set = "Email me a magic link" enabled.
# RESEND_API_KEY=
# EMAIL_FROM=StackLens <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Error tracking (optional, Sentry free tier). Backend errors only — no
# tracing, no performance data (tracesSampleRate 0). Unset = SDK never loads.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# ---------------------------------------------------------------------------

# Frontend Sentry DSN — must live in frontend/.env (or Vercel env) and be
# VITE_-prefixed, because Vite only exposes VITE_* vars to the browser bundle.
# This is a public value (a DSN is safe to expose); everything else stays
# server-side. Unset = Sentry code is never even bundled.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# ---------------------------------------------------------------------------
# Testing — connection string for the DB-gated integration tests
# (test/integration/auth.test.js + test/integration/features.test.js).
# When unset, those suites are skipped. Example with a local container:
#   docker run -d --name stacklens-test-pg -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=stacklens_test -p 5432:5432 postgres:16-alpine
#   TEST_DATABASE_URL=postgresql://postgres:testpass@127.0.0.1:5432/stacklens_test
# ---------------------------------------------------------------------------
# TEST_DATABASE_URL=
